# Crash reporting. Every variable here is optional.
#
# Without VITE_SENTRY_DSN the Sentry client is never started, the app makes no
# request of its own, and the crash-reporting switch does not appear in
# Settings. That is the default for local development and for a fork — copy
# this file to .env.local and fill in a DSN only if you are running your own
# Sentry project.

VITE_SENTRY_DSN=

# Attributes reports to a version. CI passes the commit SHA.
VITE_SENTRY_RELEASE=

# 0 to 1. Left at 0: every map pan issues tile requests, so tracing buries the
# signal in tile spans unless a build is specifically investigating timing.
VITE_SENTRY_TRACES_SAMPLE_RATE=0
