{
  "name": "Run Log — understand your run",
  "short_name": "Run Log",
  "description": "A free, open-source run explorer. Drop in a file from your watch and read what actually happened during the run.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f4f3f1",
  "theme_color": "#fc5200",
  "icons": [
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
